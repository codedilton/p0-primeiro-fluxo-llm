# Copie este arquivo para .env e preencha com os seus valores:
#   cp .env.example .env
# O arquivo .env NÃO vai para o Git (protegido pelo .gitignore).

# Chave de API do seu provedor de IA.
# Groq: gere a sua gratuitamente em https://console.groq.com/keys
IA_API_KEY=cole-a-sua-chave-aqui

# Opcional: endpoint e modelo do provedor de IA.
# Padrao: endpoint compativel com OpenAI do Groq, modelo openai/gpt-oss-20b
# IA_API_URL=https://api.groq.com/openai/v1/chat/completions
# IA_MODEL=openai/gpt-oss-20b
