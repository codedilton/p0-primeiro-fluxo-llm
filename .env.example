# Copie este arquivo para .env e preencha com os seus valores:
#   cp .env.example .env
# O arquivo .env NÃO vai para o Git (protegido pelo .gitignore).
# No container da plataforma, use as mesmas variáveis no dashboard
# (uma por linha, no campo de variáveis de ambiente).

# Endpoint do provedor de IA, no formato compatível com OpenAI.
# Padrão: LLM interno do ambiente (acessível somente pela rede interna,
# de dentro do container; não abre no navegador da sua máquina).
IA_API_URL=https://llm-internal.softex:9001/v1/chat/completions

# Modelo do provedor (padrão do ambiente interno).
IA_MODEL=qwen3.5:9b-q4_K_M

# Credencial do provedor. Se o endpoint interno não exige credencial,
# deixe vazia e defina IA_NO_AUTH=1.
IA_API_KEY=
IA_NO_AUTH=0

# TLS: 0 = NÃO verifica o certificado (padrão; o ambiente interno usa
# certificado próprio, sem cadeia pública). 1 = verifica (para
# provedores com TLS público, ex.: api.groq.com).
IA_TLS_VERIFY=0

# Timeout da chamada ao provedor, em segundos (padrão 30).
IA_TIMEOUT=30
